<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        x:Class="up.MainMenuWindow"
        Width="800"
        Height="600"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Title="Главное меню системы"
        FontFamily="Segoe UI">
    
    <Grid Background="#F5F5F5">
    

        <!-- Основное содержимое -->
        <Border Background="White" 
                CornerRadius="8"
                Padding="40"
                Width="600"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                BoxShadow="0 5 15 #CCCCCC">
            <StackPanel Spacing="25">
                <TextBlock Text="Выберите раздел:" 
                           FontSize="18" 
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                
                <!-- Кнопки меню -->
                <Button Content="Отчет о мероприятиях" 
                        Click="CustomerOrders_Click"
                        FontSize="16"
                        Padding="20,12"
                        Background="#2A5798"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="4"
                        HorizontalAlignment="Stretch"/>
            
            </StackPanel>
        </Border>

        <!-- Подвал -->
        <TextBlock Text="© 2025 Система управления мероприятиями. Версия Альфа-0.0.1"
                   FontSize="11"
                   Foreground="#777777"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>
    </Grid>
</Window>